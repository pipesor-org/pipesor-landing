---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image: ImageMetadata; alt: string; label: string; caption: string; open: string; eager?: boolean; }
const { image, alt, label, caption, open, eager = false } = Astro.props;
---
<figure class="product-image">
  <div class="image-label"><span>{label}</span><a href={image.src} target="_blank" rel="noopener">{open}</a></div>
  <a class="image-link" href={image.src} target="_blank" rel="noopener" aria-label={`${open}: ${alt}`}><Image src={image} alt={alt} widths={[480, 800, 1200, 1900]} sizes="(max-width: 700px) calc(100vw - 48px), (max-width: 1200px) calc(100vw - 64px), 1200px" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} /></a>
  <figcaption>{caption}</figcaption>
</figure>
