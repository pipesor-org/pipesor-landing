---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image: ImageMetadata; alt: string; label: string; caption: string; open: string; eager?: boolean; sizes?: string; }
const { image, alt, label, caption, open, eager = false, sizes = '(max-width: 700px) calc(100vw - 48px), (max-width: 1200px) calc(100vw - 64px), 1200px' } = Astro.props;
---
<figure class="product-image">
  <button type="button" class="image-link" data-lightbox-src={image.src} data-image-width={image.width} data-image-height={image.height} aria-label={`${open}: ${caption}`} aria-haspopup="dialog" aria-controls="image-viewer" disabled>
    <Image src={image} alt={alt} widths={[480, 800, 1200, 1900]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
    <span class="image-expand" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 4h6v6M10 20H4v-6M20 4l-6 6M4 20l6-6" /></svg>{open}</span>
  </button>
  <figcaption><p>{caption}</p><span class="image-disclosure">{label}</span></figcaption>
</figure>
