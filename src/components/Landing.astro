---
import '@fontsource/sora/latin-400.css';
import '@fontsource/sora/latin-500.css';
import '@fontsource/sora/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '../styles/global.css';
import sora400 from '@fontsource/sora/files/sora-latin-400-normal.woff2?url';
import sora500 from '@fontsource/sora/files/sora-latin-500-normal.woff2?url';
import sora600 from '@fontsource/sora/files/sora-latin-600-normal.woff2?url';
import EarlyAccess from './EarlyAccess';
import Brand from './Brand.astro';
import ImageLightbox from './ImageLightbox.astro';
import ProductImage from './ProductImage.astro';
import { content, type Locale } from '../i18n/content';
import operations from '../assets/product/operations.webp';
import validation from '../assets/product/validation.webp';
import uncertainty from '../assets/product/uncertainty.webp';
import historyEn from '../assets/product/history-en.webp';
import historyEs from '../assets/product/history-es.webp';
import insightsEn from '../assets/product/insights-en.webp';
import insightsEs from '../assets/product/insights-es.webp';
const { locale = 'en' } = Astro.props as { locale: Locale };
const c = content[locale];
const canonicalUrl = new URL(locale === 'en' ? '/' : '/es/', Astro.site).href;
const views = [
  { id: 'incidents', image: operations, alt: c.operationsAlt, caption: c.operationsCaption, label: 'english' },
  { id: 'review', image: validation, alt: c.validationAlt, caption: c.validationCaption, label: 'english' },
  { id: 'history', image: locale === 'es' ? historyEs : historyEn, alt: c.historyAlt, caption: c.historyCaption, label: 'local' },
];
const localizedLabel = `${c.screenshotLabel}${locale === 'es' ? ` · ${c.englishImage}` : ''}`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {[sora400, sora500, sora600].map(href => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />)}
    <meta name="description" content={c.description} />
    <meta name="theme-color" content="#f7f8fa" />
    <meta property="og:title" content={c.title} /><meta property="og:description" content={c.description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonicalUrl} /><meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} /><meta property="og:image" content={new URL('/social-card.png', Astro.site).href} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={c.socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site).href} /><link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site).href} /><link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/branding/pipesor_symbol_primary_light_v1.0.svg" media="(prefers-color-scheme: light)" /><link rel="icon" type="image/svg+xml" href="/branding/pipesor_symbol_primary_dark_v1.0.svg" media="(prefers-color-scheme: dark)" /><link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" /><link rel="apple-touch-icon" sizes="180x180" href="/icon-180.png" />
    <title>{c.title}</title>
    <script is:inline>
      (() => {
        let preference = 'system';
        try { const saved = localStorage.getItem('pipesor.theme'); if (['system', 'light', 'dark'].includes(saved)) preference = saved; } catch {}
        document.documentElement.dataset.theme = preference === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : preference;
        document.documentElement.dataset.preference = preference;
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{c.skip}</a>
    <header class="site-header">
      <div class="header-inner frame">
        <a class="brand" href={locale === 'en' ? '/' : '/es/'} aria-label={c.home}><Brand /></a>
        <nav class="main-nav" aria-label={c.navLabel}>{c.nav.map((label, index) => <a href={['#workflow', '#product', '#questions'][index]}>{label}</a>)}</nav>
        <div class="preferences">
          <div class="language-control" role="group" aria-label={c.language}>
            {(['en', 'es'] as const).map(language => <a href={language === 'en' ? '/' : '/es/'} lang={language} hreflang={language} aria-label={language === 'en' ? 'English' : 'Español'} aria-current={language === locale ? 'page' : undefined} data-language={language !== locale ? '' : undefined}>{language.toUpperCase()}</a>)}
          </div>
          <fieldset class="theme-control">
            <legend class="visually-hidden">{c.theme}</legend>
            {['system', 'light', 'dark'].map((theme, index) => <label title={c.themes[index]}><input type="radio" name="theme" value={theme} checked={theme === 'system'} /><span class="theme-option"><svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">{theme === 'system' ? <><rect x="3" y="4" width="16" height="11" rx="1.5" /><path d="M8 19h6m-3-4v4" /></> : theme === 'light' ? <><circle cx="11" cy="11" r="3.5" /><path d="M11 1v2m0 16v2M1 11h2m16 0h2M4 4l1.5 1.5m11 11L18 18M4 18l1.5-1.5m11-11L18 4" /></> : <path d="M18.8 13A8 8 0 0 1 9 3.2 8 8 0 1 0 18.8 13Z" />}</svg><span class="visually-hidden">{c.themes[index]}</span></span></label>)}
          </fieldset>
        </div>
        <a class="button header-cta" href="#early-access" aria-label={c.cta}>{c.headerCta}</a>
      </div>
    </header>
    <main id="main">
      <section class="hero frame" aria-labelledby="hero-title">
        <div class="hero-top">
          <h1 id="hero-title">{c.headline.map(line => <span class="headline-line"><span>{line}</span></span>)}</h1>
          <div class="hero-intro"><p class="hero-subhead">{c.subhead}</p><div class="hero-conversion"><div class="hero-actions"><a class="button" href="#early-access">{c.cta}<span aria-hidden="true">↓</span></a><a class="text-link" href="#workflow">{c.secondary}</a></div><p class="prototype">{c.prototype}</p><p class="small">{c.availability}</p></div></div>
        </div>
        <div class="hero-stage"><ProductImage image={operations} alt={c.operationsAlt} label={localizedLabel} caption={c.operationsCaption} open={c.openImage} eager sizes="(max-width: 700px) 980px, (max-width: 1200px) calc(100vw - 96px), 1168px" /></div>
      </section>
      <section id="workflow" class="workflow section frame" aria-labelledby="workflow-title" data-reveal>
        <div class="workflow-lead"><h2 id="workflow-title">{c.workflowHeading}</h2><p>{c.workflowIntro}</p><p class="scope-note">{c.prototypeScope}</p></div>
        <div class="investigation" role="group" aria-label={c.workflowConcept}>
          {c.steps.map(([title, text], index) => <details class="workflow-stage" name="investigation" open={index === 2}>
            <summary><h3>{title}</h3><svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 8 5 5 5-5" /></svg></summary>
            <div class="stage-content"><p>{text}</p>
              {index === 0 && <ul class="evidence-inputs">{c.workflowEvidence.map(item => <li>{item}</li>)}</ul>}
              {index === 2 && <div class="diagnosis-branches">{c.workflowBranches.map(([name, description]) => <div><h4>{name}</h4><p>{description}</p></div>)}</div>}
              {index === 3 && <p class="stage-note">{c.validationDetail}</p>}
            </div>
          </details>)}
        </div>
      </section>
      <section id="product" class="product section frame" aria-labelledby="product-title" data-reveal>
        <div class="section-heading"><h2 id="product-title">{c.productHeading}</h2><p>{c.productIntro}</p></div>
        <fieldset class="product-browser">
          <legend class="visually-hidden">{c.productLegend}</legend>
          {views.map((view, index) => <><input class="view-radio visually-hidden" type="radio" name="product-view" id={`view-${view.id}`} value={view.id} checked={view.id === 'review'} /><label class="view-choice" for={`view-${view.id}`} id={`label-${view.id}`}><span class="view-name">{c.productViews[index]}<span aria-hidden="true">›</span></span><span class="view-description">{c.productViewDescriptions[index]}</span></label></>)}
          <div class="browser-panels">{views.map(view => <div class={`browser-panel panel-${view.id}`} role="group" aria-labelledby={`label-${view.id}`}><ProductImage image={view.image} alt={view.alt} label={view.label === 'english' ? localizedLabel : c.screenshotLabel} caption={view.caption} open={c.openImage} sizes="(max-width: 900px) calc(100vw - 96px), 800px" /></div>)}</div>
        </fieldset>
      </section>
      <section class="uncertainty section" aria-labelledby="uncertainty-title" data-reveal>
        <div class="frame uncertainty-inner"><div class="section-heading"><h2 id="uncertainty-title">{c.uncertaintyHeading}</h2><p>{c.uncertaintyText}</p></div><ProductImage image={uncertainty} alt={c.uncertaintyAlt} label={localizedLabel} caption={c.uncertaintyDetail} open={c.openImage} sizes="(max-width: 700px) 1400px, (max-width: 1200px) calc(100vw - 64px), 1200px" /></div>
      </section>
      <section class="memory section frame" aria-labelledby="memory-title" data-reveal>
        <div class="memory-copy"><h2 id="memory-title">{c.memoryHeading}</h2><p>{c.memoryText}</p><a class="text-link" href="#product" data-history-link>{c.productViews[2]}</a></div>
        <ProductImage image={locale === 'es' ? insightsEs : insightsEn} alt={c.insightsAlt} label={c.screenshotLabel} caption={c.insightsCaption} open={c.openImage} sizes="(max-width: 900px) calc(100vw - 96px), 700px" />
      </section>
      <section id="questions" class="faq section frame" aria-labelledby="questions-title" data-reveal>
        <div><h2 id="questions-title">{c.questionsHeading}</h2></div>
        <div class="questions-list">{c.questions.map(([question, answer], index) => <details name="questions" open={index === 0}><summary>{question}<svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 8 5 5 5-5" /></svg></summary><p>{answer}</p></details>)}</div>
      </section>
      <section id="early-access" class="access section" aria-labelledby="access-title" data-reveal>
        <div class="access-inner frame"><div class="access-copy"><h2 id="access-title">{c.accessHeading}</h2><p>{c.accessText}</p><p class="prototype">{c.prototype}</p><a class="text-link" href="#product">{c.productHeading}</a></div><EarlyAccess locale={locale} client:visible /></div>
      </section>
    </main>
    <footer class="site-footer">
      <div class="frame">
        <div class="footer-top">
          <div class="footer-identity"><a class="brand footer-brand" href="#top" aria-label={c.top}><Brand /></a><p>{c.footer.description}</p></div>
          <nav class="footer-column" aria-labelledby="footer-project-title">
            <h2 id="footer-project-title">{c.footer.project}</h2>
            <ul>
              <li><a href="#product">{c.footer.overview}</a></li>
              <li><a href="https://github.com/pipesor-org/pipesor-landing">pipesor-landing</a></li>
              <li class="footer-planned"><span>pipesor-docs</span><span class="footer-note">{c.footer.docsPlanned}</span></li>
            </ul>
          </nav>
          <nav class="footer-column" aria-labelledby="footer-contributors-title">
            <h2 id="footer-contributors-title">{c.footer.contributors}</h2>
            <ul><li><a href="https://github.com/Chaomeum">Jhon Galvez</a></li><li><a href="https://github.com/RamiroGuzmanCh">Ramiro Guzman</a></li></ul>
          </nav>
          <section class="footer-column footer-legal" aria-labelledby="footer-legal-title">
            <h2 id="footer-legal-title">{c.footer.legal}</h2>
            <ul><li class="footer-planned"><span>{c.footer.privacy}</span><span class="footer-note">{c.footer.pending}</span></li><li class="footer-planned"><span>{c.footer.terms}</span><span class="footer-note">{c.footer.pending}</span></li></ul>
          </section>
        </div>
        <div class="footer-bottom"><p class="footer-license">{c.footer.licensing}</p><a class="text-link" href="#top">{c.top}<span aria-hidden="true">↑</span></a></div>
        <p class="footer-copyright">© {new Date().getFullYear()}. {c.footer.copyright}</p>
      </div>
    </footer>
    <ImageLightbox locale={locale} />
    <script>
      const choices = [...document.querySelectorAll<HTMLInputElement>('input[name="theme"]')];
      const system = matchMedia('(prefers-color-scheme: dark)');
      let preference = document.documentElement.dataset.preference || 'system';
      const apply = () => {
        document.documentElement.dataset.theme = preference === 'system' ? (system.matches ? 'dark' : 'light') : preference;
        document.documentElement.dataset.preference = preference;
        choices.forEach(choice => { choice.checked = choice.value === preference; });
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', document.documentElement.dataset.theme === 'dark' ? '#0e1116' : '#f7f8fa');
      };
      apply();
      choices.forEach(choice => choice.addEventListener('change', () => { if (choice.checked) { preference = choice.value; apply(); try { localStorage.setItem('pipesor.theme', preference); } catch {} } }));
      system.addEventListener('change', () => { if (preference === 'system') apply(); });
      const language = document.querySelector<HTMLAnchorElement>('[data-language]')!;
      const preserveAnchor = () => { language.hash = window.location.hash; };
      preserveAnchor();
      window.addEventListener('hashchange', preserveAnchor);
      document.querySelector('[data-history-link]')?.addEventListener('click', () => {
        const history = document.querySelector<HTMLInputElement>('#view-history')!;
        history.checked = true;
        history.focus({ preventScroll: true });
      });
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      if (!reducedMotion.matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => entries.forEach(entry => {
          if (entry.isIntersecting) { entry.target.classList.add('is-revealed'); observer.unobserve(entry.target); }
        }), { threshold: 0.08 });
        document.querySelectorAll('[data-reveal]').forEach(section => observer.observe(section));
      }
    </script>
  </body>
</html>
